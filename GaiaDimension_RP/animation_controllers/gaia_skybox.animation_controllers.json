{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.gaia_sky.rendering" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"summon" : "q.is_local_player && !q.is_in_ui && v.cloud_picker == 0 &&  q.property(gaia:in_gaia)"
						},
						{
							"summon0" : "q.is_local_player && !q.is_in_ui && v.cloud_picker == 1 &&  q.property(gaia:in_gaia)"
						},
						{
							"summon1" : "q.is_local_player && !q.is_in_ui && v.cloud_picker == 2 &&  q.property(gaia:in_gaia)"
						},
						{
							"summon2" : "q.is_local_player && !q.is_in_ui && v.cloud_picker == 3 &&  q.property(gaia:in_gaia)"
						},
						{
							"summon3" : "q.is_local_player && !q.is_in_ui && v.cloud_picker == 2 &&  q.property(gaia:in_gaia)"
						},
						{
							"summon4" : "q.is_local_player && !q.is_in_ui && v.cloud_picker == 3 &&  q.property(gaia:in_gaia)"
						}
					]
				},
				"summon" : {
					"animations": ["one_second_timer"],
					"particle_effects": [
						{
						  	"effect": "sky_side1"
						}
					],
					"transitions" : [
						{
