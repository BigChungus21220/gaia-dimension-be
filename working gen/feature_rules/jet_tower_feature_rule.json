{
	"format_version": "1.20.20",
	"minecraft:feature_rules": {
		"description": {
			"identifier": "gaiadimension:jet_tower_feature_rule",
			"places_feature": "gaiadimension:gen/structures/jet_tower_feature"
		},
		"conditions": {
			"placement_pass": "final_pass",
			"minecraft:biome_filter": [
				{
					"any_of": [
						{
							"test": "has_biome_tag",
							"value": "overworld"
						},
						{
							"test": "has_biome_tag",
							"value": "overworld_generation"
						}
					]
				}
			]
		},
		"distribution": {
			"iterations": "v.originx >= 100000 && v.originz >= 100000 && v.originx <= 400000 && v.originz <= 400000",
			"x": {
				"extent": [
					0,
					15
				],
				"distribution": "uniform"
			},
			"y": "query.above_top_solid(v.worldx, v.worldz)",
			"z": {
				"extent": [
					0,
					15
				],
				"distribution": "uniform"
			},
			"scatter_chance": {
				"numerator": 1,
				"denominator": 1000
			}
		}
	}
}
