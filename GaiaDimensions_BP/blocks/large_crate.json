{
  "format_version": "1.21.70",
  "minecraft:block": {
    "description": {
      "identifier": "gaiadimension:large_crate",
      "menu_category": {
        "category": "items",
        "group": "minecraft:itemGroup.name.furnaces",
        "is_hidden_in_commands": false
      },
      "states": {
        "gaiadimension:direction": [
          0,
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "gaiadimension:lit": [
          false,
          true
        ],
        "gaiadimension:entity": [
          false,
          true
        ]
      }
    },
    "components": {
      "minecraft:collision_box": true,
      "minecraft:selection_box": true,
      "minecraft:material_instances": {
        "*": {
          "texture": "large_crate",
          "render_method": "opaque",
          "minecraft:map_color": "#ffffff"
        }
      },
      "minecraft:on_placed": {
