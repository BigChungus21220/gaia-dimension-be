                            0,
                            -8
                        ],
                        "size": [
                            16,
                            8,
                            16
                        ]
                    },
                    "minecraft:selection_box": {
                        "origin": [
                            -8,
                            0,
                            -8
                        ],
                        "size": [
                            16,
                            8,
                            16
                        ]
                    },
                    "minecraft:on_interact": {
                        "event": "gaia:full_slab",
                        "condition": "q.block_face == 1.0 && q.is_item_name_any('slot.weapon.mainhand','gaia:crusted_jade_brick_slab')"
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:vertical_half') == 'top' && !query.block_state('gaia:double')",
                "components": {
                    "minecraft:collision_box": {
                        "origin": [
                            -8,
                            8,
                            -8
                        ],
                        "size": [
                            16,
                            8,
                            16
                        ]
                    },
                    "minecraft:selection_box": {
                        "origin": [
                            -8,
                            8,
                            -8
                        ],
                        "size": [
                            16,
                            8,
                            16
                        ]
                    },
                    "minecraft:on_interact": {
                        "event": "gaia:full_slab",
                        "condition": "q.block_face == 0.0 && q.is_item_name_any('slot.weapon.mainhand','gaia:crusted_jade_brick_slab')"
                    }
                }
            },
            {
                "condition": "query.block_state('gaia:double')",
                "components": {
                    "minecraft:unit_cube": {},
                    "minecraft:on_player_destroyed": {
                        "event": "gaia:double_destroy"
                    }
                }
            }
        ],
        "components": {
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 7
            },
            "minecraft:destructible_by_explosion": {
