{
    "format_version": "1.21.70",
    "minecraft:block": {
        "description": {
            "identifier": "gaiadimension:crusted_jade_brick_slab",
            "menu_category": {
                "category": "construction"
            },
            "traits": {
                "minecraft:placement_position": {
                    "enabled_states": [
