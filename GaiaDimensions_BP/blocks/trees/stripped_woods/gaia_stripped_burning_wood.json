{
  "format_version": "1.21.70",
  "minecraft:block": {
    "description": {
      "identifier": "gaiadimension:stripped_burning_wood",
      "menu_category": {
        "category": "nature",
        "group": "itemGroup.name.wood"
      },
      "states": {
        "gaiadimension:rotation": [
          0,
          1,
          2
        ]
      }
    },
    "components": {
      "minecraft:map_color": "#636566",
      "minecraft:on_player_placing": {
        "event": "gaiadimension:rotate"
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "stripped_burning_log_side",
          "render_method": "opaque"
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 2
      },
      "minecraft:loot": "loot_tables/blocks/trees/stripped_woods/stripped_burning_wood.json"
    },
    "events": {
      "gaiadimension:rotate": {
        "set_block_state": {
          "gaiadimension:rotation": "Math.floor(query.block_face / 2)"
        }
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('gaia:rotation') == 0",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('gaia:rotation') == 1",
        "components": {
          "minecraft:geometry": "minecraft:geometry.full_block",
          "minecraft:transformation": {
            "rotation": [
              90,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('gaia:rotation') == 2",
        "components": {
          "minecraft:geometry": "minecraft:geometry.full_block",
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              90
            ]
          }
        }
      }
    ]
  }
}