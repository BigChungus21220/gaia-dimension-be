{
  "format_version": "1.21.70",
  "minecraft:block": {
    "description": {
      "identifier": "gaiadimension:corrupted_leaves",
      "states": {
        "gaiadimension:decay_tier": [
          6,
          5,
          4,
          3,
          2,
          1,
          0
        ],
        "gaiadimension:not_decay": [
          false,
          true
        ],
        "gaiadimension:solid": [
          false,
          true
        ]
      },
      "menu_category": {
        "category": "nature",
        "group": "itemGroup.name.leaves"
      }
    },
    "components": {
      "minecraft:loot": "loot_tables/blocks/trees/leaves/corrupted_leaves.json",
      "minecraft:on_player_placing": {
        "event": "gaiadimension:stop_decay",
        "target": "self"
      },
      "minecraft:on_player_destroyed": {
        "event": "gaiadimension:on_destroyed"
      },
      "minecraft:random_ticking": {
        "on_tick": {
          "event": "check",
          "target": "block"
        }
      },
      "minecraft:queued_ticking": {
        "looping": true,
        "interval_range": [
          0,
          0
        ],
        "on_tick": {
          "event": "check"
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.3
      },
      "minecraft:map_color": "#FFFFFF",
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 1
      },
      "minecraft:light_emission": 15,
      "minecraft:light_dampening": 8,
      "tag:gaiadimension:corrupted_leaves": {},
      "minecraft:material_instances": {
        "*": {
          "texture": "corrupted_leaves",
          "render_method": "blend",
          "ambient_occlusion": true,
          "face_dimming": true
        }
      }
    },
    "events": {
      "gaiadimension:on_destroyed": {
        "sequence": [
          {
            "condition": "query.is_item_name_any('slot.weapon.mainhand','shears')",
            "spawn_loot": {
              "table": "loot_tables/blocks/gaia/corrupted_leaves_sheared.json"
            }
          },
          {
            "condition": "!query.is_item_name_any('slot.weapon.mainhand','shears')",
            "spawn_loot": {
              "table": "loot_tables/blocks/gaia/corrupted_leaves.json"
            }
          }
        ]
      },
      "check": {
        "sequence": [
          {
            "condition": "q.block_state('gaia:not_decay') == false",
            "set_block_state": {
              "gaiadimension:decay_tier": "(    q.block_neighbor_has_any_tag(0,0,-1,'gaia:corrupted_log') ||    q.block_neighbor_has_any_tag(0,0,1,'gaia:corrupted_log') ||    q.block_neighbor_has_any_tag(-1,0,0,'gaia:corrupted_log') ||    q.block_neighbor_has_any_tag(1,0,0,'gaia:corrupted_log') ||    q.block_neighbor_has_any_tag(0,-1,0,'gaia:corrupted_log') ||    q.block_neighbor_has_any_tag(0,1,0,'gaia:corrupted_log')) ?     6: (    (        q.block_neighbor_has_any_tag(0,0,-1,'gaia:decay_tier_6') ||         q.block_neighbor_has_any_tag(0,0,1,'gaia:decay_tier_6') ||         q.block_neighbor_has_any_tag(-1,0,0,'gaia:decay_tier_6') ||         q.block_neighbor_has_any_tag(1,0,0,'gaia:decay_tier_6') ||         q.block_neighbor_has_any_tag(0,-1,0,'gaia:decay_tier_6') ||         q.block_neighbor_has_any_tag(0,1,0,'gaia:decay_tier_6')    ) ?        5     : (         (            q.block_neighbor_has_any_tag(0,0,-1,'gaia:decay_tier_5') ||             q.block_neighbor_has_any_tag(0,0,1,'gaia:decay_tier_5') ||             q.block_neighbor_has_any_tag(-1,0,0,'gaia:decay_tier_5') ||             q.block_neighbor_has_any_tag(1,0,0,'gaia:decay_tier_5') ||             q.block_neighbor_has_any_tag(0,-1,0,'gaia:decay_tier_5') ||             q.block_neighbor_has_any_tag(0,1,0,'gaia:decay_tier_5')        ) ?            4         : (             (                q.block_neighbor_has_any_tag(0,0,-1,'gaia:decay_tier_4') ||                 q.block_neighbor_has_any_tag(0,0,1,'gaia:decay_tier_4') ||                 q.block_neighbor_has_any_tag(-1,0,0,'gaia:decay_tier_4') ||                 q.block_neighbor_has_any_tag(1,0,0,'gaia:decay_tier_4') ||                 q.block_neighbor_has_any_tag(0,-1,0,'gaia:decay_tier_4') ||                 q.block_neighbor_has_any_tag(0,1,0,'gaia:decay_tier_4')            ) ?                3            : (                (                    q.block_neighbor_has_any_tag(0,0,-1,'gaia:decay_tier_3') ||                     q.block_neighbor_has_any_tag(0,0,1,'gaia:decay_tier_3') ||                     q.block_neighbor_has_any_tag(-1,0,0,'gaia:decay_tier_3') ||                     q.block_neighbor_has_any_tag(1,0,0,'gaia:decay_tier_3') ||                     q.block_neighbor_has_any_tag(0,-1,0,'gaia:decay_tier_3') ||                     q.block_neighbor_has_any_tag(0,1,0,'gaia:decay_tier_3')                ) ?                    2                : (                    (                        q.block_neighbor_has_any_tag(0,0,-1,'gaia:decay_tier_2') ||                         q.block_neighbor_has_any_tag(0,0,1,'gaia:decay_tier_2') ||                         q.block_neighbor_has_any_tag(-1,0,0,'gaia:decay_tier_2') ||                         q.block_neighbor_has_any_tag(1,0,0,'gaia:decay_tier_2') ||                         q.block_neighbor_has_any_tag(0,-1,0,'gaia:decay_tier_2') ||                         q.block_neighbor_has_any_tag(0,1,0,'gaia:decay_tier_2')                    ) ?                        1                    : (                        0                    )                )            )        )     ) )"
            }
          },
          {
            "set_block_state": {
              "gaiadimension:solid": "q.block_neighbor_has_any_tag(0,0,-1,'gaia:corrupted_log','gaia:corrupted_leaves') && q.block_neighbor_has_any_tag(0,0,1,'gaia:corrupted_log','gaia:corrupted_leaves') && q.block_neighbor_has_any_tag(0,1,0,'gaia:corrupted_log','gaia:corrupted_leaves') && q.block_neighbor_has_any_tag(0,-1,0,'gaia:corrupted_log','gaia:corrupted_leaves') && q.block_neighbor_has_any_tag(-1,0,0,'gaia:corrupted_log','gaia:corrupted_leaves') && q.block_neighbor_has_any_tag(1,0,0,'gaia:corrupted_log','gaia:corrupted_leaves')"
            }
          }
        ]
      },
      "gaiadimension:stop_decay": {
        "set_block_state": {
          "gaiadimension:not_decay": true
        }
      },
      "gaiadimension:decay": {
        "die": {}
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('gaia:decay_tier') == 0",
        "components": {
          "tag:gaiadimension:decay_tier_0": {},
          "minecraft:random_ticking": {
            "on_tick": {
              "event": "gaiadimension:decay"
            }
          }
        }
      },
      {
        "condition": "query.block_state('gaia:decay_tier') == 1",
        "components": {
          "tag:gaiadimension:decay_tier_1": {}
        }
      },
      {
        "condition": "query.block_state('gaia:decay_tier') == 2",
        "components": {
          "tag:gaiadimension:decay_tier_2": {}
        }
      },
      {
        "condition": "query.block_state('gaia:decay_tier') == 3",
        "components": {
          "tag:gaiadimension:decay_tier_3": {}
        }
      },
      {
        "condition": "query.block_state('gaia:decay_tier') == 4",
        "components": {
          "tag:gaiadimension:decay_tier_4": {}
        }
      },
      {
        "condition": "query.block_state('gaia:decay_tier') == 5",
        "components": {
          "tag:gaiadimension:decay_tier_5": {}
        }
      },
      {
        "condition": "query.block_state('gaia:decay_tier') == 6",
        "components": {
          "tag:gaiadimension:decay_tier_6": {}
        }
      },
      {
        "condition": "query.block_state('gaia:solid') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "corrupted_leaves_opaque",
              "render_method": "opaque"
            }
          }
        }
      }
    ]
  }
}