{
  "format_version": "1.21.70",
  "minecraft:block": {
    "description": {
      "identifier": "gaiadimension:liquid_bismuth",
      "states": {
        "gaiadimension:x": [
          0,
          1
        ],
        "gaiadimension:nx": [
          0,
          1
        ],
        "gaiadimension:z": [
          0,
          1
        ],
        "gaiadimension:nz": [
          0,
          1
        ],
        "gaiadimension:top": [
          0,
          1
        ],
        "gaiadimension:bottom": [
          0,
          1
        ]
      }
    },
    "components": {
      "minecraft:on_interact": {
        "event": "gaiadimension:pick_up",
        "condition": "query.is_item_name_any('slot.weapon.mainhand', 0, 'gaia:scaynyx_bucket')",
        "target": "other"
      },
      "minecraft:queued_ticking": {
        "looping": true,
        "interval_range": [
          0.2,
          0.2
        ],
        "on_tick": {
          "event": "gaiadimension:flow"
        }
      },
      "minecraft:loot": "loot_tables/blocks/fluids/liquid_bismuth/liquid_bismuth.json",
      "minecraft:material_instances": {
        "*": {
          "texture": "liquid_bismuth_still",
          "render_method": "blend"
        }
      },
      "tag:template": {},
      "tag:template_full": {},
      "tag:fluid": {},
      "minecraft:geometry": {
        "identifier": "geometry.fluid",
        "bone_visibility": {
          "x": "query.block_state('gaia:x') == 0",
          "nx": "query.block_state('gaia:nx') == 0",
          "z": "query.block_state('gaia:z') == 0",
          "nz": "query.block_state('gaia:nz') == 0",
          "top": "query.block_state('gaia:top') == 0",
          "bottom": "query.block_state('gaia:bottom') == 0"
        }
      },
      "minecraft:light_dampening": 0.0,
      "minecraft:light_emission": 15,
      "minecraft:destructible_by_mining": false,
      "minecraft:collision_box": false,
      "minecraft:destructible_by_explosion": false,
      "minecraft:flammable": false
    },
    "events": {
      "gaiadimension:flow": {
        "sequence": [
          {
            "run_command": {
              "target": "self",
              "command": [
                "execute if block ~ ~-1 ~ air run setblock ~ ~-1 ~ gaiadimension:liquid_bismuth_down"
              ]
            }
          },
          {
            "run_command": {
              "target": "self",
              "command": [
                "execute if block ~ ~ ~1 air unless block ~ ~-1 ~ gaiadimension:liquid_bismuth_down run setblock ~ ~ ~1 gaiadimension:liquid_bismuth1"
              ]
            }
          },
          {
            "run_command": {
              "target": "self",
              "command": [
                "execute if block ~ ~ ~-1 air unless block ~ ~-1 ~ gaiadimension:liquid_bismuth_down run setblock ~ ~ ~-1 gaiadimension:liquid_bismuth1"
              ]
            }
          },
          {
            "run_command": {
              "target": "self",
              "command": [
                "execute if block ~1 ~ ~ air unless block ~ ~-1 ~ gaiadimension:liquid_bismuth_down run setblock ~1 ~ ~ gaiadimension:liquid_bismuth1"
              ]
            }
          },
          {
            "run_command": {
              "target": "self",
              "command": [
                "execute if block ~-1 ~ ~ air unless block ~ ~-1 ~ gaiadimension:liquid_bismuth_down run setblock ~-1 ~ ~ gaiadimension:liquid_bismuth1"
              ]
            }
          },
          {
            "condition": "query.block_neighbor_has_any_tag(0, 0, -1, 'template_full')",
            "set_block_state": {
              "gaiadimension:nz": 1
            }
          },
          {
            "condition": "query.block_neighbor_has_any_tag(0, 0, 1, 'template_full')",
            "set_block_state": {
              "gaiadimension:z": 1
            }
          },
          {
            "condition": "query.block_neighbor_has_any_tag(1, 0, 0, 'template_full')",
            "set_block_state": {
              "gaiadimension:x": 1
            }
          },
          {
            "condition": "query.block_neighbor_has_any_tag(-1, 0, 0, 'template_full')",
            "set_block_state": {
              "gaiadimension:nx": 1
            }
          },
          {
            "condition": "query.block_neighbor_has_any_tag(0, 1, 0, 'template_full')",
            "set_block_state": {
              "gaiadimension:top": 1
            }
          },
          {
            "condition": "query.block_neighbor_has_any_tag(0, -1, 0, 'template_full')",
            "set_block_state": {
              "gaiadimension:bottom": 1
            }
          },
          {
            "condition": "!query.block_neighbor_has_any_tag(0, 0, -1, 'template_full')",
            "set_block_state": {
              "gaiadimension:nz": 0
            }
          },
          {
            "condition": "!query.block_neighbor_has_any_tag(0, 0, 1, 'template_full')",
            "set_block_state": {
              "gaiadimension:z": 0
            }
          },
          {
            "condition": "!query.block_neighbor_has_any_tag(1, 0, 0, 'template_full')",
            "set_block_state": {
              "gaiadimension:x": 0
            }
          },
          {
            "condition": "!query.block_neighbor_has_any_tag(-1, 0, 0, 'template_full')",
            "set_block_state": {
              "gaiadimension:nx": 0
            }
          },
          {
            "condition": "!query.block_neighbor_has_any_tag(0, 1, 0, 'template_full')",
            "set_block_state": {
              "gaiadimension:top": 0
            }
          },
          {
            "condition": "!query.block_neighbor_has_any_tag(0, -1, 0, 'template_full')",
            "set_block_state": {
              "gaiadimension:bottom": 0
            }
          }
        ]
      },
      "gaiadimension:pick_up": {
        "decrement_stack": {},
        "run_command": {
          "command": "give @p gaiadimension:liquid_bismuth_bucket"
        },
        "die": {}
      }
    }
  }
}