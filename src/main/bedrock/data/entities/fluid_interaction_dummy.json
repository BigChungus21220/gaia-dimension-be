{
    "format_version": "1.21.70",
    "minecraft:entity": {
        "description": {
            "identifier": "gaiadimension:fluid_interaction_dummy",
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false
        },
        "components": {
            "minecraft:collision_box": { "width": 0.1, "height": 0.1 },
            "minecraft:physics": { "has_gravity": false, "has_collision": false },
            "minecraft:health": { "value": 1, "max": 1 },
            "minecraft:damage_sensor": {
                "triggers": { "cause": "all", "deals_damage": false }
            },
            "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
            "minecraft:type_family": { "family": [ "gaiadimension:fluid_interaction_dummy", "inanimate" ] },
            "minecraft:custom_hit_test": {
                "hitboxes": [
                    { "pivot": [0, 0.5, 0], "width": 1.0, "height": 1.0 }
                ]
            },
            "minecraft:interact": {
                "interactions": [
                    {
                        "on_interact": {
                            "filters": {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            }
                        }
                    }
                ]
            }
        }
    }
}
