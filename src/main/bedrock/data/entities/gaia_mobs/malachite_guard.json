    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["defend"]
        }
      },
      "mg_defend": {
        "remove": {
          "component_groups": ["normal", "resist", "stomp_active", "charge_active"]
        },
        "add": {
          "component_groups": ["defend"]
        }
      },
      "no_mg_defend": {
        "remove": {
          "component_groups": ["defend", "stomp_active", "charge_active"]
        },
        "add": {
          "component_groups": ["normal"]
        }
      },
      "mg_resist": {
        "remove": {
          "component_groups": ["normal", "defend", "stomp_active", "charge_active"]
        },
        "add": {
          "component_groups": ["resist"]
        }
      },
      "no_mg_resist": {
        "remove": {
          "component_groups": ["resist"]
        },
        "add": {
          "component_groups": ["normal"]
        }
      },
      "mg_stomp_start": {
        "add": {
          "component_groups": ["stomp_active"]
        }
      },
      "mg_stomp_end": {
        "remove": {
          "component_groups": ["stomp_active"]
        }
      },
      "mg_charge_start": {
        "add": {
          "component_groups": ["charge_active"]
        }
      },
      "mg_charge_end": {
        "remove": {
          "component_groups": ["charge_active"]
        }
      }
